<?xml version="1.0" encoding="utf-8"?>
<LocalMultiplayerPreferences xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <PlayerCount>1</PlayerCount>
  <TwoPlayerLayout>FullHeight</TwoPlayerLayout>
  <SingleMode>
    <DefaultRoutes>
      <Player1Users>*</Player1Users>
    </DefaultRoutes>
    <UserOverrides />
  </SingleMode>
  <MultiplayerMode>
    <DefaultRoutes>
      <Player1Users>[a-m]*</Player1Users>
      <Player2Users>[n-z]*</Player2Users>
    </DefaultRoutes>
    <UserOverrides />
  </MultiplayerMode>
  <FourPlayerMode>
    <DefaultRoutes>
      <Player1Users>[a-f]*</Player1Users>
      <Player2Users>[g-m]*</Player2Users>
      <Player3Users>[n-s]*</Player3Users>
      <Player4Users>[t-z]*</Player4Users>
    </DefaultRoutes>
    <UserOverrides />
  </FourPlayerMode>
</LocalMultiplayerPreferences>
